rules_version = '2';

// Firestore Security Rules for the MindCraft / AiDots club platform.
// Project: website-b84d2
//
// Deploy with:  firebase deploy --only firestore:rules
// Or paste into Firebase Console -> Firestore Database -> Rules -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'mindcraftaiclub@gmail.com') ||
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── User Profiles ────────────────────────────────────────────────────
    match /Users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ── Public Registration & Submissions ─────────────────────────────────
    match /EventRegistrations/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /Notifications/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /ContactMessages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /JoinRequests/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Admin-Managed Content (Public Read, Admin Write) ──────────────────
    match /CoreMembers/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /Events/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /Gallery/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /Announcements/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /Resources/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /WeeklyWinners/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /WeeklyTasks/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /Tasks/{id}                { allow read: if true; allow write: if isAdmin(); }
    match /Badges/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /JoinFormFields/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /Quiz/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /Projects/{id}             { allow read: if true; allow write: if isAdmin(); }
    match /Settings/{id}             { allow read: if true; allow write: if isAdmin(); }
    match /Challenges/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /ChallengeLeaderboard/{id} { allow read: if true; allow write: if isAdmin(); }
    match /ChallengeAnalytics/{id}   { allow read: if true; allow write: if isAdmin(); }

    // ── User Activity & Learning ──────────────────────────────────────────
    match /QuizResults/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /QuizAttempt/{id} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /TaskSubmissions/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /ChallengeSubmissions/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /ChallengeDrafts/{id} {
      allow read, write: if isAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid
      ));
    }

    match /ChallengeDiscussions/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /Violations/{id} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ── Catch-All Fallback ───────────────────────────────────────────────
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
